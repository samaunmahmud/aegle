# Copy to .env and change every value. .env is git-ignored.
# LOCAL DEVELOPMENT ONLY. Load into your shell before starting the API:
#   set -a; source .env; set +a

POSTGRES_USER=aegle
POSTGRES_PASSWORD=change-me-postgres
# Password of the restricted role the API connects as (row-level security applies to it).
APP_DB_PASSWORD=change-me-app-db

MINIO_ROOT_USER=aegle-minio
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars

ORTHANC_USER=aegle
ORTHANC_PASSWORD=change-me-orthanc

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# PHI protection keys: 32 random bytes, base64. Generate each with:
#   openssl rand -base64 32
# Losing the encryption key makes stored patient identifiers unrecoverable.
AEGLE_PHI_ENC_KEY=
AEGLE_PHI_HASH_KEY=

# Shared secret the Core API presents to the inference service (at least 32 chars).
# Both processes read it from the environment. Generate with:
#   openssl rand -base64 32
AEGLE_INFERENCE_TOKEN=
